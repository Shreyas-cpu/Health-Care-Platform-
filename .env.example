# ==============================================================================
# Digital Healthcare Services Platform - Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Digital Healthcare Services Platform"
API_V1_STR="/api/v1"

# Database (PostgreSQL 16 with btree_gist)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/healthcare_platform
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5432/healthcare_platform

# Redis (Cache, Distributed Locking, Pub/Sub Bridge)
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=dev_insecure_jwt_secret_healthcare_platform_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Gateway (Razorpay - Indian Rails: UPI & Cards)
RAZORPAY_KEY_ID=rzp_test_healthcare_sandbox_key
RAZORPAY_KEY_SECRET=rzp_test_healthcare_sandbox_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# S3 / MinIO Object Storage (Verification Docs & Prescription PDFs)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1
S3_BUCKET_DOCUMENTS=doctor-documents
S3_BUCKET_PRESCRIPTIONS=prescriptions
S3_USE_SSL=false

# Real-Time Teleconsultation & LiveKit SFU
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Notifications & Email (Local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@healthcare-platform.local
EMAILS_FROM_NAME="Healthcare Platform"
